# Server
PORT=3000
HOST=0.0.0.0

# CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Rate Limiting
PULSE_RATE_POINTS=5
PULSE_RATE_DURATION=3
COLOR_CHANGE_COOLDOWN=300

# Sync Settings
SYNC_WINDOW_MS=600
SYNC_REQUIRED_USERS=2

# Discord Webhooks (optional)
DISCORD_WEBHOOK_URL=

# Database (required for auth, XP, and persistence)
DATABASE_URL=

# GitHub OAuth (required for user authentication)
# Create an OAuth app at https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
JWT_SECRET=pulseboard-dev-secret-change-me

# Server Public URL (required for OAuth redirect in production)
# Example: https://your-app.railway.app
SERVER_PUBLIC_URL=

# AI Features (optional)
OPENAI_API_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# Stripe (optional)
STRIPE_SECRET_KEY=
